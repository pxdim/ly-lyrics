# ============================================
# LY - 歌詞顯示系統 環境變數
# ============================================

# ==================== Application ====================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# ==================== Go Backend ====================
# Go 後端 API 位址（Next.js 透過 rewrites 代理 /api/* 到此位址）
GO_BACKEND_URL=http://localhost:8080

# Go 後端 WebSocket 位址（前端直連）
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# ==================== NextAuth.js ====================
# NextAuth configuration（仍由 Next.js 處理 session 管理）
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl_rand_base64_32

# ==================== Gemini API (Optional) ====================
# AI features (歌詞解析、格式化等)
GEMINI_API_KEY=your_gemini_api_key_here

# ==================== NDI Output (Optional) ====================
# NDI 輸出設定
NDI_ENABLED=false
NDI_WIDTH=1920
NDI_HEIGHT=1080
NDI_FRAME_RATE=30
NDI_ALPHA_CHANNEL=true

# ==================== Analytics (Optional) ====================
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ==================== Deployment ====================
# Railway deployment URL
RAILWAY_PUBLIC_URL=

