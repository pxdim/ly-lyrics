# ============================================
# LY - 歌詞顯示系統 環境變數
# ============================================

# ==================== Application ====================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# ==================== Go Backend ====================
# Go 後端 API 位址（Next.js 透過 rewrites 代理 /api/* 到此位址）
GO_BACKEND_URL=http://localhost:8080

# Go 後端 WebSocket 位址（前端直連）
NEXT_PUBLIC_GO_WS_URL=ws://localhost:8080/ws

# 啟用原生 WebSocket（Go backend）
NEXT_PUBLIC_USE_NATIVE_WS=true

# ==================== Lyrics Search Providers (Optional) ====================
# LRClib: 免費，無需 API Key，永遠啟用

# LrcApi / HisAtri（自架 Docker，中文歌詞來源）
LRCAPI_URL=http://localhost:28883/api
LRCAPI_AUTH_KEY=your_lrcapi_auth_key_here

# Genius API（歌曲元資料搜尋）
GENIUS_API_TOKEN=your_genius_api_token_here

# Gemini API（AI 歌詞搜尋，備用來源）
GEMINI_API_KEY=your_gemini_api_key_here
