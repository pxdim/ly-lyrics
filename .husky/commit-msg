#!/bin/bash
# LY Commit Message Hook
# 強制使用 Conventional Commits 格式

commit_msg=$(cat "$1")

# Conventional Commits 格式
# feat: new feature
# fix: bug fix
# docs: documentation changes
# style: formatting, missing semi colons, etc
# refactor: refactoring production code
# test: adding tests
# chore: updating build tasks, package manager configs, etc

pattern="^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert)(\(.+\))?\!?: .{1,}"

if [[ ! $commit_msg =~ $pattern ]]; then
  echo "❌ Invalid commit message format!"
  echo ""
  echo "請使用 Conventional Commits 格式:"
  echo "  feat: add song search feature"
  echo "  fix: resolve Supabase connection issue"
  echo "  docs: update README"
  echo "  chore: update dependencies"
  echo ""
  echo "格式: <type>(<scope>): <description>"
  echo ""
  echo "可用的 types:"
  echo "  feat, fix, docs, style, refactor, test, chore, build, ci, perf"
  exit 1
fi

echo "✅ Commit message format OK!"
